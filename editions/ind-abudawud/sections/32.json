        "Abdullah bin Muhammad An Nufaili",
        "Hatim bin Isma'il",
        "Nashr bin 'Ashim",
        "Yahya bin Sa'id",
        "Ja'far bin Muhammad",
        "Ayahnya",
        "Jabir"
      ]
    },
